# Copy to /var/lib/osticket/.env on baser4wm (mode 600). Never commit real secrets.
# Use: docker compose --env-file /var/lib/osticket/.env -f docker-compose.production.yml ...

MYSQL_DATABASE=osticket
MYSQL_USER=osticket
MYSQL_PASSWORD=change-me-strong
MYSQL_ROOT_PASSWORD=change-me-root-strong

# Host path to ost-config.php (create from docker/ost-config.php before first install)
OSTICKET_CONFIG_PATH=/var/lib/osticket/ost-config.php
# false during install; true after install (then: compose up -d --force-recreate web)
OSTICKET_CONFIG_READONLY=false

# install | production | auto (auto: production after OSTINSTALLED=TRUE)
OSTICKET_MODE=auto

# Image tag for rollback (git SHA recommended)
OSTICKET_IMAGE_TAG=local

# --- Backup script (scripts/backup-osticket.sh) ---
RESTIC_REPOSITORY=/mnt/production-backups/baser4wm/osticket/restic-repo
RESTIC_PASSWORD_FILE=/var/lib/osticket/restic-password
BACKUP_STAGING=/var/lib/osticket/backups/staging
NFS_MOUNT_POINT=/mnt/production-backups
NFS_EXPECTED_SOURCE=10.0.0.240:/mnt/storage/production-backups/baser4wm
