# Temporary installation configuration; include in the HTTPS server block.
# Create /etc/nginx/secrets/osticket-install.htpasswd first. After installation,
# replace this include with nginx-prsmusa-osticket.conf.example. Never include both.

location = /ticket {
    return 308 /ticket/;
}

location ^~ /ticket/ {
    client_max_body_size 32m;
    proxy_pass http://127.0.0.1:18003;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_redirect off;
    auth_basic "osTicket acceptance";
    auth_basic_user_file /etc/nginx/secrets/osticket-install.htpasswd;
}

location = /ticket/setup {
    return 308 /ticket/setup/;
}

location ^~ /ticket/setup/ {
    client_max_body_size 32m;
    proxy_pass http://127.0.0.1:18003;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_redirect off;
    auth_basic "osTicket install";
    auth_basic_user_file /etc/nginx/secrets/osticket-install.htpasswd;
}
