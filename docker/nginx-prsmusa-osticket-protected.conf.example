# Post-install acceptance configuration: keep the whole helpdesk protected.
# Include only this variant until launch is authorized; then replace it with
# nginx-prsmusa-osticket.conf.example. Setup remains blocked in both variants.

location = /ticket {
    return 308 /ticket/;
}

location ^~ /ticket/ {
    client_max_body_size 32m;
    proxy_pass http://127.0.0.1:18003;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_redirect off;
    auth_basic "osTicket acceptance";
    auth_basic_user_file /etc/nginx/secrets/osticket-install.htpasswd;
}

location = /ticket/setup {
    return 404;
}

location ^~ /ticket/setup/ {
    return 404;
}
