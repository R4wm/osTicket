# Deploy to prsmusa.com as /etc/nginx/snippets/prsmusa-osticket.conf
# Include from the prsmusa.com server block.

location = /ticket {
    return 308 /ticket/;
}

location ^~ /ticket/ {
    client_max_body_size 32m;
    proxy_pass http://127.0.0.1:18003;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_redirect off;
}

# During install: duplicate proxy + headers, add auth_basic (see docs/deploy-prsmusa.md).
# After install:
# location ^~ /ticket/setup/ { return 404; }
